{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Custom Language",
    "scopeName": "source.customlang",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#storage-types"
        },
        {
            "include": "#storage-modifiers"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#characters"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#function-definition"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.customlang",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.customlang",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.customlang",
                    "match": "\\b(if|else|while|for|switch|case|default|break|continue|return)\\b"
                },
                {
                    "name": "keyword.other.import.customlang",
                    "match": "\\b(import)\\b"
                },
                {
                    "name": "keyword.other.fn.customlang",
                    "match": "\\b(fn)\\b"
                }
            ]
        },
        "storage-types": {
            "patterns": [
                {
                    "name": "storage.type.customlang",
                    "match": "\\b(void|int|float|char|bool|string|list|var)\\b"
                }
            ]
        },
        "storage-modifiers": {
            "patterns": [
                {
                    "name": "storage.modifier.customlang",
                    "match": "\\b(const)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.customlang",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.customlang",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.customlang",
                            "match": "\\\\(n|t|r|\\\\|\"|'|\\{|\\})"
                        },
                        {
                            "name": "meta.embedded.expression.customlang",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "$self"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "characters": {
            "patterns": [
                {
                    "name": "string.quoted.single.customlang",
                    "match": "'([^'\\\\]|\\\\.)'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.customlang",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.customlang",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "function-definition": {
            "patterns": [
                {
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.other.fn.customlang"
                        },
                        "2": {
                            "name": "entity.name.function.customlang"
                        }
                    }
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "name": "support.function.builtin.customlang",
                    "match": "\\b(print|println|input)\\s*(?=\\()"
                },
                {
                    "name": "entity.name.function.call.customlang",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.customlang",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.comparison.customlang",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.logical.customlang",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.assignment.customlang",
                    "match": "(=|\\+=|-=|\\*=|/=|%=)"
                },
                {
                    "name": "keyword.operator.arithmetic.customlang",
                    "match": "(\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.bitwise.customlang",
                    "match": "(&|\\||\\^|~|<<|>>)"
                },
                {
                    "name": "keyword.operator.increment.customlang",
                    "match": "(\\+\\+|--)"
                },
                {
                    "name": "keyword.operator.ternary.customlang",
                    "match": "(\\?|:)"
                }
            ]
        }
    }
}