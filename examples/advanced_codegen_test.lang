// Advanced CodeGen Test

// Arrow function
fn square(int x) int => x * x;

// Ternary in arrow function
fn max(int a, int b) int => a > b ? a : b;

// Default parameters
fn greet(string name, string msg = "Hello") void {
    print(msg);
    print(", ");
    println(name);
}

fn add3(int a, int b = 10, int c = 20) int {
    return a + b + c;
}

fn main() int {
    println("Testing Advanced Features...");
    
    // Test Arrow Function
    print("square(5) = ");
    println(square(5));
    
    // Test Ternary
    print("max(10, 20) = ");
    println(max(10, 20));
    print("max(30, 5) = ");
    println(max(30, 5));
    
    // Test Default Parameters
    print("greet('World'): ");
    greet("World");
    
    print("greet('User', 'Hi'): ");
    greet("User", "Hi");
    
    print("add3(5): ");
    println(add3(5)); // 5 + 10 + 20 = 35
    
    print("add3(5, 5): ");
    println(add3(5, 5)); // 5 + 5 + 20 = 30
    
    print("add3(5, 5, 5): ");
    println(add3(5, 5, 5)); // 5 + 5 + 5 = 15
    
    println("Advanced Test Done.");
    return 0;
}
